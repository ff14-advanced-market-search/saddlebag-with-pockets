{
  "name": "saddlebag.exchange",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "proxy": "https://localhost:3000",
  "homepage": "https://saddlebagexchange.com/",
  "sideEffects": false,
  "scripts": {
    "build": "run-s \"build:css\" \"build:remix\"",
    "build:css": "yarn run generate:css --minify",
    "build:remix": "remix build",
    "dev": "yarn run generate:css && run-p \"dev:css\" \"dev:remix\"",
    "dev:css": "yarn run generate:css --watch",
    "dev:remix": "remix dev --manual -c \"yarn run dev:wrangler\"",
    "dev:wrangler": "NODE_ENV=development wrangler pages dev ./public --compatibility-date=2026-05-03",
    "generate:css": "npx tailwindcss -o ./app/tailwind.css",
    "prettier": "prettier --write app",
    "prettier:check": "prettier --check app",
    "test": "vitest",
    "prepare": "husky",
    "write-items": "yarn run write-ffxiv-items && prettier --write app/utils/items/ffxivItems.ts && yarn run write-wow-items && prettier --write app/utils/items/wowItems.ts && yarn run write-gw2-items && prettier --write app/utils/items/gw2Items.ts && yarn run prettier",
    "write-ffxiv-items": "node ./scripts/write-ffxiv-items.js && prettier --write app/utils/items/ffxivItems.ts",
    "write-wow-items": "node ./scripts/write-wow-items.js && prettier --write app/utils/items/wowItems.ts",
    "write-gw2-items": "node ./scripts/write-gw2-items.js && prettier --write app/utils/items/gw2Items.ts"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@datadog/browser-rum": "^7.10.0",
    "@discordjs/rest": "^2.6.3",
    "@reduxjs/toolkit": "^2.12.0",
    "@remix-run/cloudflare": "^2.17.5",
    "@remix-run/cloudflare-pages": "^2.17.5",
    "@remix-run/node": "^2.17.5",
    "@remix-run/react": "^2.17.5",
    "@remix-run/router": "1.23.3",
    "@tanstack/match-sorter-utils": "^8.19.4",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "discord-api-types": "^0.38.54",
    "highcharts": "^11.4.8",
    "highcharts-react-official": "^3.2.3",
    "react": "^18.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dnd-scrolling": "^1.3.10",
    "react-dnd-touch-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.0",
    "react-tailwindcss-datepicker": "1.7.3",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@remix-run/dev": "^2.17.5",
    "@remix-run/eslint-config": "^2.17.5",
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "browserslist": "^4.28.8",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "prettier": "2.8.8",
    "prettier-config-standard": "^5.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "update-browserslist-db": "^1.3.2",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7",
    "wrangler": "4.86.0"
  },
  "prettier": "prettier-config-standard",
  "lint-staged": {
    "*.{ts,tsx,js}": "eslint --cache --fix",
    "*.{ts,tsx,js,css,md}": "prettier --write"
  }
}
